  //   } catch (error: any) {
  //     if (error.response && error.response.status === 404) {
  //       setRuleExists(false);
  //       setModalMessage(t('importTypologyPage.noExistingRuleFound'));
  //       setIsModalVisible(true);
  //     } else {
  //       console.error('Error checking for existing rule:', error);
  //       showErrorModal(error?.response?.data?.message || t('importTypologyPage.errorCreatingRule'));
  //     }
  //   } finally {
  //     setLoading(false);
  //   }
  // };

  // const checkForExistingTypology = async (fileContent: any) => {
  //   setLoading(true);
  //   try {
  //     const typology = fileContent.typology;
  //     let typologyName = typology?.name;
  //     typologyName = String(typologyName).trim();

  //     if (!typologyName || typologyName === '') {
  //       showErrorModal(t('importTypologyPage.invalidTypologyName'));
  //       setLoading(false);
  //       return;
  //     }

  //     if (!typology?.cfg || typology.cfg === '') {
  //       showErrorModal(t('importTypologyPage.invalidConfig'));
  //       setLoading(false);
  //       return;
  //     }

  //     const response = await Api.get(`/typology/name/${encodeURIComponent(typologyName)}`);

  //     if (response.data && response.data._key) {
  //       setTypologyExists(true);
  //       setExistingTypologyVersion(response.data.cfg);
  //       setExistingTypologyId(response.data._id);
  //       setModalMessage(t('importTypologyPage.existingTypologyFound'));
  //       setIsModalVisible(true);
  //     } else {
  //       setTypologyExists(false);
  //       setModalMessage(t('importTypologyPage.noExistingTypologyFound'));
  //       setIsModalVisible(true);
  //     }
  //   } catch (error: any) {
  //     if (error.response && error.response.status === 404) {
  //       setTypologyExists(false);
  //       setModalMessage(t('importTypologyPage.noExistingTypologyFound'));
  //       setIsModalVisible(true);
  //     } else {
  //       console.error('Error checking for existing typology:', error);
  //       showErrorModal(error?.response?.data?.message || t('importTypologyPage.errorCheckingTypology'));
