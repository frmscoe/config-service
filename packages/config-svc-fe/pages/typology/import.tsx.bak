  const handleFileUpload = async (file: any) => {
  const reader = new FileReader();

  reader.onload = async () => {
    try {
      const json = JSON.parse(reader.result as string);
      const { typology_name, id, cfg, threshold, rules, expression } = json;

      if (!typology_name || !id || !cfg || !threshold || !rules || !expression) {
        showErrorModal("Invalid Typology JSON file.");
        return;
      }

      const [name] = id.split("@");
      const desc = typology_name;

      const score = { threshold, rules, expression };

      // Check if Typology already exists
      // const existingTypologyRes = await Api.get(`/typology/name/${encodeURIComponent(name)}`);
      // if (existingTypologyRes?.data?._id) {
      //   showErrorModal(`Typology with name "${name}" already exists.`);
      //   return;
      // }

      let typologyId = null;

      try {
        const existingTypologyRes = await Api.get(`/typology/name/${encodeURIComponent(name)}`);
        typologyId = existingTypologyRes?.data?._id;
        console.log(`Typology "${name}" already exists with ID: ${typologyId}`);
      } catch (err: any) {
        if (err?.response?.status === 404) {
          console.warn(`Typology "${name}" not found. Creating new typology...`);
        } else {
          showErrorModal(err?.response?.data?.message || "Error checking typology existence.");
          return;
        }
      }

      if (!typologyId) {
        const createRes = await Api.post("/typology", {
          name,
          cfg,
          desc,
          typologyCategoryUUID: [],
          rules_rule_configs: [], // empty for now; will be patched after
          referenceId: null,
          score: {}, // placeholder
        });
        typologyId = createRes?.data?._id;
        console.log(`Typology "${name}" created with ID: ${typologyId}`);
      }


      // Extract unique rule names from score.rules
      const ruleNames = [...new Set(rules.map((r: any) => r.id.split('@')[0]))];

      const rules_rule_configs: { ruleId: string; ruleConfigId: string[] }[] = [];

      for (const ruleName of ruleNames) {
        let ruleId: string | null = null;

        try {
          const res = await Api.get(`/rule/${encodeURIComponent(ruleName)}`);
          ruleId = res?.data?._id || null;
        } catch (err) {
          console.warn(`Rule "${ruleName}" not found. Creating...`);
        }

        if (!ruleId) {
          const createRes = await Api.post(`/rule`, {
            name: ruleName,
            cfg: cfg,
            expression: null,
            tags: [],
          });
          ruleId = createRes?.data?._id;
        }

        if (ruleId) {
          rules_rule_configs.push({
            ruleId,
            ruleConfigId: [],
          });
        }
      }

      const payload = {
        name,
        cfg,
        desc,
        typologyCategoryUUID: [],
        rules_rule_configs,
        referenceId: null,
        score,
      };

      await Api.post("/typology", payload);
      showSuccessModal(`Typology "${name}" imported successfully.`);
    } catch (err: any) {
      console.error("Typology Import Error:", err);
      showErrorModal(err?.response?.data?.message || "Failed to import typology.");
    }
  };

  reader.readAsText(file);
  return false;
};



  const showErrorModal = (content: string) => {
    setModalMessage(content);
    setIsErrorModalVisible(true);
  };

