const checkForExistingNetworkMap = async (fileContent: any): Promise<{ exists: boolean; id?: string; version?: string }> => {
  try {
    const mapName = fileContent.messages?.[0]?.id?.split('@')[0]?.trim();
    const cfg = fileContent.messages?.[0]?.cfg;

    if (!mapName) {
      throw new Error(t('importNetworkMapPage.invalidNetworkMapName'));
    }

    if (!cfg) {
      throw new Error(t('importNetworkMapPage.invalidConfig'));
    }

    const response = await Api.get(`/network-map/name/${encodeURIComponent(mapName)}`);

    if (response.data && response.data._key) {
      return {
        exists: true,
        id: response.data._id,
        version: response.data.cfg || cfg,
      };
    }

    return { exists: false };
  } catch (error: any) {
    if (error.response?.status === 404) {
      return { exists: false }; // Not found = good, proceed to create
    }

    console.error('Error checking for existing network map:', error);
    throw new Error(error?.response?.data?.message || t('importNetworkMapPage.errorCheckingNetworkMap'));
  }
};



const handleCancel = () => {
  setIsErrorModalVisible(false);
  setIsModalVisible(false);
  setIsSavingModalVisible(false);
  setModalMessage(null);
};

  const handleOk = () => {
    setIsModalVisible(false);
    setRuleCreated(false);
    setModalMessage(null);
  };

  if (!canImportRule) {
    return <AccessDeniedPage />;
  }

  return (
  <div className="import-rule-config">
    <h1>{t('importNetworkMapPage.ImportRuleConfigTitle')}</h1>

    <Dragger beforeUpload={handleFileUpload} showUploadList={false}>
      <p className="ant-upload-drag-icon">
        <InboxOutlined />
      </p>
      <p className="ant-upload-text">{t('importNetworkMapPage.uploadPrompt')}</p>
      <p className="ant-upload-hint">{t('importNetworkMapPage.uploadHint')}</p>
    </Dragger>

    {loading && <Spin size="large" />}

    <Modal
      title={t('importNetworkMapPage.ruleCreatedSuccess')}
      open={isModalVisible && ruleCreated}
      onCancel={handleOk}
      footer={[
        <Button key="ok" type="primary" style={lightBlueButtonStyle} onClick={handleOk}>
          {t('importNetworkMapPage.OK')}
        </Button>,
      ]}
    >
      <p>{modalMessage}</p>
    </Modal>
  </div>
);
};

export default ImportNetWorkMap;



