  const processNetworkMapImport = async (json: any) => {
  try {
    console.log("🚀 Starting network map import...");
    setLoading(true);

    const message = json.messages?.[0];
    const networkMapName = message?.id?.split('@')[0]?.trim();
    const cfg = message?.cfg;
    const eventId = message?.txTp?.replace(/\./g, "_");

    if (!networkMapName || !cfg || !eventId) {
      console.error("❌ Missing required network map info:", { networkMapName, cfg, eventId });
      throw new Error("Invalid network map JSON structure");
    }

    console.log("✅ Extracted map info:", { networkMapName, cfg, eventId });

    // Step 1: Check if Network Map already exists
    const { exists } = await checkForExistingNetworkMap(json);

    if (exists) {
      console.warn(`⚠️ Network map "${networkMapName}" already exists`);
      setModalMessage(t("importNetworkMapPage.networkMapExists"));
      setIsErrorModalVisible(true);
      return;
    }

    const typologyPayloads = [];

    // Step 2: Process each typology in channels
    for (const channel of message.channels || []) {
      for (const typ of channel.typologies || []) {
        const typologyName = typ.id.split('@')[0];
        const typologyCfg = typ.cfg;
        let typologyId: string;

        const rulesWithConfigsArray: any[] = []; // Array to hold constructed rulesWithConfigs objects

        // Step 3: Handle rules (Create if they don’t exist)
        for (const rule of typ.rules || []) {
          const ruleName = rule.id.split('@')[0];
          const ruleCfg = rule.cfg;
          let ruleId: string; // To store the _id of the rule

          try {
            const res = await Api.get(`/rule/name/${encodeURIComponent(ruleName)}`);
            ruleId = res.data?.[0]?._id; // Get existing rule ID
          } catch (ruleErr: any) {
            if (ruleErr.response?.status === 404) {
              const newRule = await Api.post('/rule', {
                name: ruleName,
                cfg: ruleCfg,
                // dataType: 'CURRENCY', // You might need to derive this or set a default
                rule_desc: '',
              });
              ruleId = newRule.data._id; // Get newly created rule ID
            } else {
              throw ruleErr;
            }
          }

          // Construct the ruleConfigs for the current rule
          // This part depends on how ruleConfigs are represented in your input JSON.
          // For now, let's assume they are directly available on the 'rule' object from the import JSON,
          // or you need to generate placeholder configs if not present.
          const currentRuleConfigs = (rule.ruleConfigs || []).map((rc: any) => ({
            _id: rc._id || `rule_config/${crypto.randomUUID()}`, // Generate if missing
            _key: rc._key || crypto.randomUUID(),
            cfg: rc.cfg,
            // Add other fields expected by your backend for ruleConfigs
          }));


          // Add the constructed ruleWithConfigs object to the array
          rulesWithConfigsArray.push({
            rule: {
              _id: ruleId,
              _key: ruleId.split('/')[1], // Assuming _id is like "rule/uuid"
              name: ruleName,
              cfg: ruleCfg,
            },
            ruleConfigs: currentRuleConfigs, // Use the constructed ruleConfigs
          });
        }

        // Step 4: Handle typology (Fetch or create, and update with missing rules)
        try {
          const typologyRes = await Api.get(`/typology/name/${encodeURIComponent(typologyName)}`);
          typologyId = typologyRes.data._id;
          const existingRuleIds = typologyRes.data.rules || [];

          // Identify missing rules from the current import
          const incomingRuleIdsForTypology = rulesWithConfigsArray.map(item => item.rule._id);
          const missingRuleIds = incomingRuleIdsForTypology.filter((id) => !existingRuleIds.includes(id));

          if (missingRuleIds.length > 0) {
            const updatedRules = [...new Set([...existingRuleIds, ...missingRuleIds])];
            await Api.put(`/typology/${typologyId}`, {
              rules: updatedRules,
            });
            console.log(`🔁 Updated typology "${typologyName}" with new rules.`);
          } else {
            console.log(`✅ Typology "${typologyName}" already contains all rules.`);
          }
        } catch (typErr: any) {
          if (typErr.response?.status === 404) {
            const newTypology = await Api.post('/typology', {
              name: typologyName,
              cfg: typologyCfg,
              threshold: typ.threshold || 50, // Use existing if available
              expression: typ.expression || {},
              rules: rulesWithConfigsArray.map(item => item.rule._id), // Only send rule IDs to typology creation
            });
            typologyId = newTypology.data._id;
          } else {
            throw typErr;
          }
        }

        // Add the typology payload with the correctly structured rulesWithConfigs
        typologyPayloads.push({
          id: `${typologyName}@${typologyCfg}`, // Matches the curl example's 'id' format
          name: typologyName,
          cfg: typologyCfg,
          active: false,
          rulesWithConfigs: rulesWithConfigsArray, // This is the crucial change
        });
      }
    }

    console.log("Typology Payload", typologyPayloads);
    const now = new Date().toISOString();
    // Step 5: Final payload for network map
    const finalPayload = {
      name: `${networkMapName} Network Map`,
      cfg: cfg,
      description: 'Imported from File',
      source: 'user_created',
      state: '01_DRAFT',
      active: false,
      createdAt: now,
      updatedAt: now,
      events: [
        {
          eventId,
          typologies: typologyPayloads,
        },
      ],
      // ownerId: 'admin@domain.com',
    };

    // const payload = {
    //     active: false,
    //     name: formData.name,
    //     description: formData.description,
    //     cfg: version,
    //     source: "user_created",
    //     createdAt: now,
    //     updatedAt: now,
    //     modifiedBy: "",
    //     ownerId: "",
    //     state: "01_DRAFT",
    //     events: [
    //       {
    //         eventId: eventNode.id,
    //         typologies: typologiesPayload
    //       }
    //     ]
    //   };

    console.log("📦 Final network map payload:", finalPayload);

    // const result = await Api.post('/network-map', finalPayload);
    try {
      const result = await Api.post('/network-map', finalPayload);
      console.log("✅ Network map created successfully:", result.data);
    } catch (error: any) {
      console.error("❌ Network map creation failed:", {
        message: error?.message,
        response: error?.response?.data,
        status: error?.response?.status,
        config: error?.config,
      });
      throw error;
    }

    // console.log("✅ Network map created successfully:", result.data);

    setModalMessage(t("importNetworkMapPage.importSuccess"));
    setIsModalVisible(true);

  } catch (error: any) {
    console.error("🔥 Error during network map import:", error);
    setModalMessage(error?.response?.data?.message || t("importNetworkMapPage.importFailed"));
    setIsErrorModalVisible(true);
  } finally {
    setLoading(false);
  }
};



  const showErrorModal = (content: string) => {
    setModalMessage(content);
    setIsErrorModalVisible(true);
  };


