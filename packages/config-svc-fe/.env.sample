PORT=4000 # this specifies the port the frontend is running

# Replacement
NEXT_PUBLIC_CONFIG_SVC_BE_URL=http://localhost:3007 # this is the config_svc_be URL
NEXT_PUBLIC_SECURITY_BC_URL=http://localhost:8080/realms/config-svc # this is the keycloak realm URL
NEXT_PUBLIC_SECURITY_BC_CLIENT_ID=config-svc-auth-lib-client # this is the keycloak client ID
NEXT_PUBLIC_SECURITY_BC_SECRET=<client_secret> # this is the keycloak client secret
