  "private": true,
  "scripts": {
    "build": "next build",
    "dev": "next dev -p 4000",
    "start:prod": "next start -p $PORT",
    "test": "jest",
    "clean": "rm -rf .next/ dist/ node_modules/",
    "audit:check": "npm run audit:check",
    "audit:fix": "npm run audit:fix",
    "clean:dist": "rm -Rf dist; npm run clean:dist",
    "clean:npm": "rm -Rf node_modules; npm run clean:npm",
    "coverage:gen-report": "nyc report --reporter=lcov --temp-dir=./coverage",
    "coverage:merge": "nyc merge ./coverage/ ./coverage/coverage.json",
    "dep:check": "ncu -e 2; npm run dep:check",
    "dep:update": "ncu -e 2 -u; npm run dep:update",
    "lint:eslint": "next lint",
    "lint:stylelint": "stylelint '**/*.{scss,css}'",
    "lint:prettier": "prettier --check '**/*.{js,jsx,ts,tsx,scss,css,json,md}'",
    "lint": "npm run lint:eslint && npm run lint:stylelint && npm run lint:prettier",
    "lint:fix": "npm run lint:fix",
    "posttest": "npm run coverage:merge && npm run coverage:gen-report",
    "pre_commit_check": "npm run build && npm run lint && npm run test:unit",
    "start:command-handler-svc": "npm -w packages/command-handler-svc run start",
    "start:event-handler-svc": "npm -w packages/event-handler-svc run start",
    "test:watch": "jest --watch"
  }
}
